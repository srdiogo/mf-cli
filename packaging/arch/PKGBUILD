# Maintainer: Diogo de Medeiros <sr.diogo@gmail.com>
# Protocol and legacy transport contributors are credited in the source tree.
pkgname=mf-cli-platform
pkgver=0.2.6.r12.g8f12a01
pkgrel=1
pkgdesc='MiniFuse CLI and DKMS transport with verified MF4 controls and meters'
arch=('x86_64')
url='https://github.com/srdiogo/mf-cli'
license=('MIT' 'GPL-2.0-only')
depends=('glibc' 'libgcc' 'libusb' 'dkms')
makedepends=('rust>=1.85' 'pkgconf')
options=('!debug')
provides=('mf-cli=0.2.6' 'minifuse-transport=1')
conflicts=('mf-cli')
_commit=8f12a01c2b71a545b129d94316321777b149304e
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('9e90e98977c5f8db976b60d0f44ba3bb462dd3ec44e9fc09d7136ab508501cc6')

prepare() {
  cd "mf-cli-$_commit"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "mf-cli-$_commit"
  cargo build --release --frozen
}

check() {
  cd "mf-cli-$_commit"
  cargo test --workspace --frozen
}

package() {
  cd "mf-cli-$_commit"
  install -Dm755 target/release/mf-cli "$pkgdir/usr/bin/mf-cli"
  install -Dm644 70-minifuse.rules "$pkgdir/usr/lib/udev/rules.d/70-minifuse.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 kmod/LICENSE "$pkgdir/usr/share/licenses/$pkgname/kernel-LICENSE"
  local dkms_dir="$pkgdir/usr/src/minifuse_mod-$pkgver" file
  for file in minifuse_mod.c mf4_protocol.h Makefile dkms.conf; do
    install -Dm644 "kmod/$file" "$dkms_dir/$file"
  done
  sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" "$dkms_dir/dkms.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  printf '%s\n' minifuse_mod > minifuse.conf.example
  install -Dm644 minifuse.conf.example "$pkgdir/usr/share/doc/$pkgname/minifuse.conf.example"
}
